                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03 Exam Scores",
      "item": [
        {
          "name": "GET Exam Settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/courses/{{course_id}}/exam-settings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "courses",
                "{{course_id}}",
                "exam-settings"
              ]
            }
          }
        },
        {
          "name": "GET Exam Scores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/courses/{{course_id}}/exam-scores",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "courses",
                "{{course_id}}",
                "exam-scores"
              ]
            }
          }
        },
        {
          "name": "POST Bulk Save Exam Scores (Sample)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exam_setting_id\": 1,\n  \"scores\": [\n    {\n      \"student_id\": \"{{student_code}}\",\n      \"score\": 18\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/courses/{{course_id}}/exam-scores/bulk",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "courses",
                "{{course_id}}",
                "exam-scores",
                "bulk"
              ]
            },
            "description": "Update exam_setting_id and student_code before sending."
          }
        }
      ]
    },
    {
      "name": "04 Public Queue",
      "item": [
        {
          "name": "POST Verify PIN",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pin_code\": \"{{pin_code}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/queue/verify-pin",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "queue",
                "verify-pin"
              ]
            }
          }
        },
        {
          "name": "GET Booking Status",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/queue/bookings/{{booking_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "queue",
                "bookings",
                "{{booking_id}}",
                "status"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001"
    }
  ]
}
