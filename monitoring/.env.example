# =============================================================================
# Monitoring Stack Environment Variables
# Copy this file to .env and fill in actual values
# =============================================================================

# --- Ports ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8080
LOKI_PORT=3100
ALERTMANAGER_PORT=9093

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production
GRAFANA_ROOT_URL=http://localhost:3030

# --- Grafana SMTP (for email alerts via Grafana) ---
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM=monitoring@itii-assist.com

# --- Alertmanager SMTP ---
SMTP_HOST=smtp.gmail.com:587
SMTP_FROM=monitoring@itii-assist.com
SMTP_USER=
SMTP_PASS=

# --- Alert Destinations ---
ALERT_WEBHOOK_URL=http://itii-prod-backend:3001/api/monitoring/webhook
ALERT_EMAIL_TO=admin@itii-assist.com
